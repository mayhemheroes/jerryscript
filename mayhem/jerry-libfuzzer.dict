# JavaScript token/keyword dictionary for the jerryscript jerry-parse/jerry-run fuzzer.
# Plain libFuzzer dict: one token per line. Tuned to steer toward valid JS structure so the
# parser+VM (not just the lexer) gets exercised.

# Statements / declarations
"var "
"let "
"const "
"function "
"return "
"if("
"else"
"for("
"while("
"do"
"switch("
"case "
"break"
"continue"
"throw "
"try"
"catch"
"finally"
"with("
"typeof "
"instanceof "
"in "
"delete "
"void "
"new "
"this"
"yield "
"async "
"await "
"class "
"extends "
"super"
"import "
"export "
"default "
"static "
"get "
"set "

# Literals
"null"
"true"
"false"
"undefined"
"NaN"
"Infinity"
"0x"
"0b"
"0o"
"1e308"
"\"\\u{1f600}\""
"\"\\xff\""

# Operators / punctuation
"=>"
"==="
"!=="
"=="
"!="
">="
"<="
"&&"
"||"
"??"
"?."
"**"
"++"
"--"
"+="
"-="
"...="
"..."
">>>"
"<<"
">>"

# Builtins / globals that drive jerry_run paths
"Object"
"Array"
"String"
"Number"
"Boolean"
"Function"
"Symbol"
"Math"
"JSON"
"Date"
"RegExp"
"Error"
"TypeError"
"Promise"
"Proxy"
"Reflect"
"Map"
"Set"
"WeakMap"
"WeakSet"
"ArrayBuffer"
"DataView"
"Uint8Array"
"parseInt"
"parseFloat"
"isNaN"
"eval("
".prototype"
".constructor"
".call("
".apply("
".bind("
".length"
".toString()"
".valueOf()"

# Structural punctuation
"();"
"{};"
"[];"
"`${"
"}`"
"(function(){})()"
